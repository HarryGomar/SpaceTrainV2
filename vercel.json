{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/Train/SpaceTrainV1.glb",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/art-atlas/",
      "destination": "/art-atlas/index.html"
    },
    {
      "source": "/:path((?!art-atlas/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/art-atlas",
      "destination": "/art-atlas/",
      "permanent": true
    }
  ]
}
